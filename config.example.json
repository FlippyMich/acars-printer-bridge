{
  "transport": "ble",
  "protocol": "auto",
  "ble": {
    "address": null,
    "name_filter": "X6",
    "write_char_uuid": null,
    "notify_char_uuid": null,
    "chunk_size": 180,
    "chunk_delay_ms": 20,
    "write_with_response": null,
    "keep_connected": true,
    "connect_timeout": 20.0,
    "scan_timeout": 8.0
  },
  "serial": {
    "port": "COM5",
    "baudrate": 9600,
    "chunk_size": 256,
    "chunk_delay_ms": 10
  },
  "catprinter": {
    "energy": 58000,
    "quality": 51,
    "drawing_mode": "text",
    "feed_steps": 120,
    "compress": false,
    "font": null,
    "line_spacing": 2,
    "threshold": 160,
    "margin_top": 4,
    "margin_bottom": 4
